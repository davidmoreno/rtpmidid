# Installed by the rtpmidid MPC package.
#
# This device has an avahi-daemon unit but no avahi-daemon binary: the MPC
# firmware does not ship avahi at all, so a unit under this name is a leftover
# from an earlier manual install. Point it at the copy inside this package
# instead of adding a second mDNS daemon next to it.
#
# Running as root is not a choice: there is no "avahi" user on these devices and
# /etc is read-only, so --no-drop-root/--no-chroot are required. avahi-daemon
# still resolves that user name on startup, so install.sh appends an entry to a
# private copy of passwd/group and binds it in -- the lines below, when needed.
[Service]
ExecStart=
ExecStart=@PREFIX@/bin/avahi-daemon --no-drop-root --no-chroot --no-rlimits -f @PREFIX@/etc/avahi-daemon.conf
Environment=LD_LIBRARY_PATH=@PREFIX@/lib
@AVAHI_USER_BIND@
