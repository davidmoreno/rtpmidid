# Generic Fedora build image. The release is selected with FEDORA_VERSION,
# which the packaging Makefile derives from the distro name (fedora-44 ->
# --build-arg FEDORA_VERSION=44), so a new Fedora release needs no new file.
ARG FEDORA_VERSION=43
FROM fedora:${FEDORA_VERSION}

# Install build dependencies
RUN dnf install -y \
    rpm-build \
    cmake \
    ninja-build \
    gcc-c++ \
    avahi-devel \
    alsa-lib-devel \
    python3 \
    pandoc \
    git \
    systemd-rpm-macros \
    && dnf clean all

# Create a non-root user for building
RUN useradd -m -s /bin/bash builder

# Copy build script
COPY ../build-rpm.sh /usr/local/bin/rtpmidid-build-rpm.sh
RUN chmod +x /usr/local/bin/rtpmidid-build-rpm.sh

WORKDIR /build
