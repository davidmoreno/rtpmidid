FROM debian:bookworm-slim

# Install build dependencies
# NOTE: bookworm ships gcc 12 / libstdc++, which has no <format> header, so the
# build falls back to C++17 + libfmt. That is why libfmt-dev is required here
# (newer distros use C++20 <format> and do not need it).
RUN apt-get update && apt-get install -y \
    build-essential \
    debhelper \
    debhelper-compat \
    libavahi-client-dev \
    libasound2-dev \
    libfmt-dev \
    python3 \
    cmake \
    pandoc \
    git \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user for building
RUN useradd -m -s /bin/bash builder

# Copy build script (build context is packaging/, so build.sh is at ../build.sh)
COPY ../build.sh /usr/local/bin/rtpmidid-build.sh
RUN chmod +x /usr/local/bin/rtpmidid-build.sh

WORKDIR /build
